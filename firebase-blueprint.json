{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction representing money received or spent.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["received", "spent"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "month": { "type": "string", "description": "YYYY-MM format for easy filtering" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "type", "amount", "description", "userId", "month"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Stored user preferences and basic info.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "description": "Base64 encoded profile image" },
        "settings": {
          "type": "object",
          "properties": {
            "darkMode": { "type": "boolean" }
          }
        }
      },
      "required": ["uid"]
    },
    "OldRecord": {
      "title": "Old Record",
      "description": "An archived Excel or CSV file stored as Base64.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "fileData": { "type": "string", "description": "Base64 encoded file content" },
        "fileType": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fileName", "fileSize", "fileData", "userId"]
    }
  },
  "firestore": {
    "transactions": {
      "schema": "Transaction",
      "description": "Collection of all family transactions."
    },
    "users": {
      "schema": "UserProfile",
      "description": "User profile data."
    },
    "old_records": {
      "schema": "OldRecord",
      "description": "Archived Excel files."
    }
  }
}
