rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Transaction Validation
    function isValidTransaction(data) {
      return data.keys().hasAll(['date', 'type', 'amount', 'description', 'userId', 'month']) &&
             data.keys().size() >= 6 &&
             data.date is string &&
             data.type in ['received', 'spent'] &&
             data.amount is number && data.amount >= 0 &&
             data.description is string && data.description.size() <= 500 &&
             data.userId == request.auth.uid &&
             data.month is string && data.month.matches('^\\d{4}-\\d{2}$');
    }

    // Transactions Rules
    match /transactions/{transactionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                    isValidTransaction(incoming()) &&
                    incoming().userId == request.auth.uid;

      allow update: if isSignedIn() &&
                    existing().userId == request.auth.uid &&
                    isValidTransaction(incoming()) &&
                    incoming().userId == existing().userId &&
                    (
                      incoming().diff(existing()).affectedKeys().hasOnly(['date', 'type', 'amount', 'description', 'paid_to', 'month', 'updatedAt'])
                    );

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
                    incoming().uid == userId &&
                    incoming().email is string;
      allow update: if isOwner(userId) &&
                    incoming().uid == userId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'settings']);
    }
  }
}
